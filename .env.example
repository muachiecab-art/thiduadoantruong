# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Vercel, set this in Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY:
# Required for shared persistent PostgreSQL storage on Vercel across all users and devices.
# Keep SUPABASE_SERVICE_ROLE_KEY strictly on the server (never prefix with VITE_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SESSION_SECRET:
# Recommended 32+ char random secret so signed Bearer tokens remain valid across Vercel serverless instances.
SESSION_SECRET=
